# ==========================================
# Freight DSS Backend Environment Configuration
# ==========================================

# Database Connection URL (Neon DB / Supabase / PostgreSQL)
# Format for Neon / Cloud: postgresql://<user>:<password>@<neon-host>/<dbname>?sslmode=require
# Format for Local Postgres: postgresql://admin:admin@localhost:5432/freight_dss
DATABASE_URL=postgresql://admin:admin@localhost:5432/freight_dss

# Allowed CORS Origins (comma-separated list of permitted origins)
# For production on Render, include your Vercel deployment URL and preview URLs
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-frontend-app.vercel.app

# Server Port (Render sets this dynamically via $PORT)
PORT=8000

# Optional Celery / Redis settings (if using background workers)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
